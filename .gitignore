# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Entornos virtuales ---
venv/
.venv/
env/
ENV/

# --- Datos: nunca subir datos reales de pacientes ni descargas pesadas ---
# GSE39582, TCGA, Synapse, etc. se descargan localmente, no se versionan.
data/*
!data/.gitkeep

# --- Salidas generadas (regenerables corriendo run_pipeline.py) ---
results/
results*/
figures/*.png
!figures/.gitkeep

# --- network_analysis/: mismo criterio, binarios/salidas locales ---
# (los datos de network_analysis/ viven en data/, ya cubierto arriba)
network_analysis/bin/
network_analysis/logs/
.snakemake/

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Editores ---
.vscode/
.idea/
*.swp

# --- Secretos / config local ---
.env
